# Laravel - dependências
/backend/vendor/

# Laravel - variáveis de ambiente e segredos
/backend/.env
/backend/.env.*
!/backend/.env.example

# Laravel - cache e arquivos gerados
/backend/bootstrap/cache/*
!/backend/bootstrap/cache/.gitignore

/backend/storage/*.key
/backend/storage/app/private/
/backend/storage/framework/cache/data/*
/backend/storage/framework/sessions/*
/backend/storage/framework/views/*
/backend/storage/logs/*

# Laravel - testes e ferramentas locais
/backend/.phpunit.cache/
/backend/.phpunit.result.cache

# PHP - arquivos temporários
/backend/*.log
/backend/.php-version

# Banco de dados local
/backend/database/*.sqlite
/backend/database/*.sqlite-*


# Environment variables
.env
.env.*

# Example environment configuration must remain versioned
!.env.example

# Python virtual environments
.venv/
venv/

# Python generated files
__pycache__/
*.py[cod]
.pytest_cache/